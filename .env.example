# Server Configuration
PORT=5000
NODE_ENV=development

# LLM Providers (Provide at least one, or leave blank to use the built-in deterministic Mock Mode)
# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (Optional Alternative)
OPENAI_API_KEY=

# Force Mock Mode (true / false). Defaults to true if no API key is provided.
MOCK_MODE=true

# Security & Limits
MAX_UPLOAD_SIZE_MB=5
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
